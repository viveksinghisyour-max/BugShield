BUGSHIELD_JWT_SECRET=replace-with-a-long-random-secret
BUGSHIELD_DB=database/bugshield.sqlite3
BUGSHIELD_UPLOAD_DIR=storage/uploads
BUGSHIELD_REPORTS_DIR=reports
BUGSHIELD_MAX_UPLOAD_MB=50
BUGSHIELD_FRONTEND_ORIGIN=http://localhost:5173
BUGSHIELD_ADMIN_EMAIL=viveksinghisyour@gmail.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# -------------------------------------------------------------
# Email OTP Delivery (HTTPS API & SMTP Configuration)
# -------------------------------------------------------------
# Option 1: Resend HTTPS API (Recommended for Render, Vercel & cloud hosting):
# Render free tier blocks outbound SMTP ports 25, 465, and 587.
# Resend uses standard HTTPS (port 443) which is never blocked.
# Get free API key in 10s at https://resend.com (3,000 free emails/month):
# RESEND_API_KEY=re_123456789
#
# Option 2: Brevo HTTPS API (https://brevo.com):
# BREVO_API_KEY=xkeysib-123456789
#
# Option 3: Standard SMTP (For local dev or unblocked servers):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_TLS=true
#
# If no email provider is configured, BugShield runs in Dev Mode
# and provides the OTP code directly via console and UI autofill.
RESEND_API_KEY=
BREVO_API_KEY=
BUGSHIELD_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true
SMTP_SSL=false