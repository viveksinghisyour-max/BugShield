BUGSHIELD_JWT_SECRET=replace-with-a-long-random-secret
BUGSHIELD_DB=database/bugshield.sqlite3
BUGSHIELD_UPLOAD_DIR=storage/uploads
BUGSHIELD_REPORTS_DIR=reports
BUGSHIELD_MAX_UPLOAD_MB=50
BUGSHIELD_FRONTEND_ORIGIN=http://localhost:5173
BUGSHIELD_ADMIN_EMAIL=viveksinghisyour@gmail.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# -------------------------------------------------------------
# Email OTP Delivery (SMTP Configuration)
# -------------------------------------------------------------
# To send REAL emails to user inboxes, configure your SMTP server below.
#
# Option A: Gmail (Recommended for testing / personal dev):
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password (16 characters)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_TLS=true
#
# Option B: Brevo / SendGrid / Resend SMTP relay:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_login
# SMTP_PASSWORD=your_smtp_key
# SMTP_FROM_EMAIL=no-reply@yourdomain.com
# SMTP_TLS=true
#
# If SMTP is left blank, BugShield runs in Dev Mode and provides
# the OTP code directly in console and the development UI banner.
BUGSHIELD_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true
SMTP_SSL=false